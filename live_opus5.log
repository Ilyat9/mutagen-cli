from victim.cache import LRUCache


def test_get_refreshes_recency_so_read_key_survives_eviction():
    cache = LRUCache(capacity=2)
    cache.set("a", 1)
    cache.set("b", 2)

    # Reading "a" must make it the most recently used entry.
    assert cache.get("a") == 1

    # Inserting a third key must evict "b", the least recently used one.
    cache.set("c", 3)

    assert cache.get("a") == 1
    assert cache.get("b") is None
    assert cache.get("c") == 3


