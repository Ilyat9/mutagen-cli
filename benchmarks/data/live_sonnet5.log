def test_invalidate_does_not_leave_stale_lru_entry_affecting_eviction():
    cache = LRUCache(capacity=2)
    cache.set("a", 1)
    cache.set("b", 2)
    cache.invalidate("a")
    cache.set("c", 3)
    cache.set("d", 4)
    # capacity is 2, so only c and d should remain; a's stale order entry
    # must not cause b to be evicted before it should, nor keep a's ghost
    # entry alive in the eviction order.
    assert cache.get("b") is None
    assert cache.get("c") == 3
    assert cache.get("d") == 4
    assert len(cache) == 2


