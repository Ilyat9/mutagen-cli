def test_set_existing_key_refreshes_recency():
    cache = LRUCache(capacity=2)
    cache.set("a", 1)
    cache.set("b", 2)
    # Re-setting "a" should mark it as most-recently-used.
    cache.set("a", 10)
    # Adding a new key should evict "b", not "a", since "a" was just refreshed.
    cache.set("c", 3)
    assert cache.get("a") == 10
    assert cache.get("b") is None
    assert cache.get("c") == 3


